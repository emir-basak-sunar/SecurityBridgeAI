# SAP AI Core BYOM Ollama — Llama 3.1 8B
# Bu dosyayi kopyalayip .env olarak kaydedin (git'e commit ETMEYIN)

LLM_PROVIDER=aicore
OLLAMA_MODEL=llama3.1:8b

# AI Core service key JSON'undan:
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_AUTH_URL=
AICORE_RESOURCE_GROUP=default

# Ollama deployment olusturduktan sonra (01-deployment.ipynb sonrasi):
AICORE_OLLAMA_DEPLOYMENT_URL=

# SAP REST API (Cloud Connector gerekir — CF'den internal host erisilemez)
SAP_API_URL=http://solmandev.btctr.local:8000/sap/bc/rest/zbtc_json_api/driver
SAP_USER=
SAP_PASSWORD=

# Sunucu deploy: frontend build icin backend URL (ornek http://sunucu-ip:8000)
# VITE_API_BASE_URL= http://localhost:8000  (frontend build sirasinda)

# CF UI + sunucu backend: CF frontend origin
# CORS_ORIGINS=http://localhost:5173,https://securitybridge-ui.cfapps.us21.hana.ondemand.com
